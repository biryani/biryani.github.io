---
layout: default
---
<div class="post project-page">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    <p class="post-description">{{ page.description }}</p>
  </header>

  <article>
    {{ content }}
  </article>

  {% if page.papers %}
    {% comment %}
      nocite registers a key for the bibliography below without putting a
      citation marker in the prose, and resolves its argument as a variable, so
      the list comes from front matter and the page body stays free text.
      Entries render in the order listed.
    {% endcomment %}
    {% for paper_key in page.papers -%}
      {%- nocite paper_key -%}
    {%- endfor %}
    <h2 class="project-papers-heading">Papers</h2>
    <div class="publications">
      {% bibliography --cited_in_order --group_by none %}
    </div>
  {% endif %}

  <div class="project-nav">
    <a href="{{ '/projects/' | relative_url }}">All research</a>
    <a href="{{ '/publications/' | relative_url }}">Full publication list</a>
  </div>
</div>
